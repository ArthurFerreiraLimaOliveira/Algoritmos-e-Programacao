algoritmo "QuatroValores"

var numero: inteiro
var valor: real
var nome: caractere
var booleano: logico

inicio

Escreva("digite um numero inteiro: ")
leia(inteiro)
Escreva("digite um numero real: ")
leia(real)
Escreva("digite um nome: ")
leia(caractere)
Escreva("digite um Booleano: ")
leia(logico)

escreva("seu numero inteiro é: " + inteiro)
escreva("seu numero real é: " + real)
escreva("seu nome é: " + caractere)
escreva("seu booleano é: " + logico)


fimalgoritmo