algoritmo "TesteCarro"

var
   marca1, modelo1: caractere
   ano1: inteiro
   marca2, modelo2: caractere
   ano2: inteiro

inicio

   marca1 <- "Wolkswagen"
   modelo1 <- "Gol"
   ano1 <- 2018

   marca2 <- "Fiat"
   modelo2 <- "Uno"
   ano2 <- 2020

   escreval("Carro 1")
   escreval("Marca: ", marca1)
   escreval("Modelo: ", modelo1)
   escreval("Ano: ", ano1)

   escreval("")

   escreval("Carro 2")
   escreval("Marca: ", marca2)
   escreval("Modelo: ", modelo2)
   escreval("Ano: ", ano2)

fimalgoritmo